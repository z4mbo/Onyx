{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onyx",
  "version": "0.2.0",
  "identifier": "com.z4mbo.onyx",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Onyx",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 }
      },
      {
        "label": "hud",
        "url": "index.html?window=hud",
        "title": "Onyx Dictation",
        "width": 236,
        "height": 58,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "agent",
        "url": "index.html?window=agent",
        "title": "Onyx Agent",
        "width": 268,
        "height": 66,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com; connect-src ipc: http://ipc.localhost https://openrouter.ai https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com wss://*.convex.cloud https://*.convex.cloud; frame-src 'self' http: https: https://challenges.cloudflare.com; img-src 'self' asset: data: blob: https:; media-src 'self' asset: data: blob: https:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Coding agents, chat, and voice in one desktop app",
    "longDescription": "Onyx wraps Claude Code, Codex, Gemini CLI, Kimi Code and OpenRouter in a native Rust desktop workspace with chat and voice.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": null,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
