{
  "name": "onyx-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Coding agents, multimodal chat, and voice in one Rust-native desktop app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/z4mbo/Onyx.git"
  },
  "overrides": {
    "diff": "8.0.3",
    "dompurify": "3.4.12"
  },
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev",
    "dev:web": "vite --port 1420 --strictPort",
    "dev:rust": "npm run build:rust-styles && node scripts/run-trunk.mjs serve --config Trunk.rust.toml",
    "dev:desktop:rust": "node scripts/run-tauri.mjs dev --config src-tauri/tauri.rust.conf.json",
    "build": "npm run typecheck && vite build",
    "build:rust": "npm run build:rust-styles && node scripts/run-trunk.mjs build --config Trunk.rust.toml --release",
    "build:rust-styles": "vite build --config vite.rust-ui.config.ts",
    "build:desktop": "node scripts/run-tauri.mjs build",
    "build:desktop:rust": "node scripts/run-tauri.mjs build --config src-tauri/tauri.rust.conf.json --no-bundle",
    "test:rust-ui": "cargo test --manifest-path frontend-rs/Cargo.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@opencode-ai/ui": "1.18.4",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "convex": "^1.42.3",
    "lucide-solid": "^0.468.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@tauri-apps/cli": "^2.8.5",
    "@types/node": "^26.1.1",
    "tailwindcss": "4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.10"
  }
}
