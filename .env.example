# Clerk's browser-safe publishable key. Configure a JWT template named `convex`.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# The deployment URL printed by `npx convex dev`.
VITE_CONVEX_URL=https://replace-me.convex.cloud

# Convex dashboard environment variable, used by convex/auth.config.ts:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
