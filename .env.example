# Chiave pubblicabile Clerk. Viene incorporata nel frontend ed è sicura da esporre.
# Se vuota, Onyx mantiene disponibile l'accesso di anteprima locale.
VITE_CLERK_PUBLISHABLE_KEY=

# Checkout pubblico del piano Onyx Managed, quando sarà disponibile.
VITE_BILLING_CHECKOUT_URL=

# Non inserire qui Clerk secret keys, Stripe secret keys o API key dei provider.
# Le variabili VITE_ vengono incluse nel bundle frontend e sono pubbliche.
